{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",

    "FileStoragePathsOptions": {

        "ProductPaths": {
            "Images_Original": "uploads/products/images/original/", // for full view, zoom
            "Images_800x1200": "uploads/products/images/800x1200/", // used when viewing an indivual product
            "Images_400x600": "uploads/products/images/400x600/", // used when listing the products in a page
            "Images_150x150": "uploads/products/images/150x150/", // used for cart preview, thumbnail


            "Reports": "uploads/products/reports/"
        }
    },


        "IdentityOptions": {

            "User": {
                "RequireUniqueEmail": true,
                "options.User.AllowedUserNameCharacters": "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-._@"
            },

            "Stores": {
                "MaxLengthForKeys": 36
            },
            "SignIn": {
                "RequireConfirmedAccount": false
            },
            "ClaimsIdentityOptions": {
                "RoleClaimType": "role",
                "UserNameClaimType": "username",
                "UserIdClaimType": "sub",
                "EmailClaimType": "email",
                "SecurityStampClaimType": "security_stamp"


            }
        }
    
}
