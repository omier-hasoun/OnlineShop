@page
@model Presentation.Pages.IndexModel
@{
    ViewData["Title"] = "Home";
}

<style>
    /* ── Banner ── */
    .quick-banner {
        background: linear-gradient(135deg, #111827 0%, #1e3a8a 55%, #1d4ed8 100%);
        border-radius: 20px;
        padding: 2.75rem 3rem;
        text-align: center;
        margin-bottom: 2.5rem;
        color: white;
        position: relative;
        overflow: hidden;
        box-shadow: 0 8px 32px rgba(17,24,39,0.25);
    }

        /* subtle dot-grid overlay */
        .quick-banner::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: radial-gradient(circle, rgba(255,255,255,0.08) 1px, transparent 1px);
            background-size: 28px 28px;
            pointer-events: none;
        }

        .quick-banner h2 {
            font-family: 'Playfair Display', serif;
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
            position: relative;
        }

        .quick-banner p {
            font-size: 1rem;
            opacity: 0.85;
            margin-bottom: 0;
            position: relative;
        }

    /* ── Section Header ── */
    .section-header {
        margin-bottom: 1.75rem;
    }

    .section-title {
        font-family: 'Playfair Display', serif;
        font-size: 1.75rem;
        font-weight: 700;
        color: var(--dark);
        margin-bottom: 0.35rem;
    }

    .section-subtitle {
        color: var(--text-secondary);
        font-size: 0.9rem;
    }

    /* ── Product Card ── */
    .product-card {
        background: #1f2937; /* slate-800 — dark, not pure black */
        border: 1px solid #374151; /* slate-700 subtle border */
        border-radius: 18px;
        overflow: hidden;
        transition: all 0.32s ease;
        height: 100%;
        display: flex;
        flex-direction: column;
        box-shadow: 0 4px 20px rgba(0,0,0,0.18);
    }

        .product-card:hover {
            transform: translateY(-7px);
            box-shadow: 0 20px 48px rgba(0,0,0,0.28);
            border-color: #1d4ed8;
        }

    /* Image area */
    .product-image-wrapper {
        position: relative;
        width: 100%;
        height: 250px;
        overflow: hidden;
        background: linear-gradient(135deg, #111827 0%, #1e3a8a 100%);
    }

        .product-image-wrapper img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.42s ease;
            opacity: 0.92;
        }

    .product-card:hover .product-image-wrapper img {
        transform: scale(1.08);
        opacity: 1;
    }

    /* Badge */
    .product-badge {
        position: absolute;
        top: 0.85rem;
        right: 0.85rem;
        background: #1d4ed8;
        color: white;
        padding: 0.28rem 0.85rem;
        border-radius: 20px;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        box-shadow: 0 2px 10px rgba(29,78,216,0.45);
    }

    /* Body */
    .product-body {
        padding: 1.5rem;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }

    .product-title {
        font-size: 1.1rem;
        font-weight: 700;
        color: #f9fafb; /* near-white text on dark card */
        margin-bottom: 0.55rem;
    }

    .product-description {
        color: #9ca3af; /* slate-400 — muted on dark bg */
        font-size: 0.87rem;
        margin-bottom: 1.25rem;
        flex-grow: 1;
        line-height: 1.65;
    }

    /* Footer row */
    .product-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 1rem;
        border-top: 1px solid #374151;
    }

    .product-price {
        font-size: 1.6rem;
        font-weight: 800;
        color: #60a5fa; /* sky-blue — pops nicely on dark */
        letter-spacing: -0.02em;
    }

    .btn-add-cart {
        background: #1d4ed8;
        color: white;
        border: none;
        padding: 0.65rem 1.35rem;
        border-radius: 10px;
        font-weight: 600;
        font-size: 0.88rem;
        cursor: pointer;
        transition: all 0.22s ease;
        display: flex;
        align-items: center;
        gap: 0.45rem;
        font-family: 'DM Sans', sans-serif;
    }

        .btn-add-cart:hover {
            background: #1e3a8a;
            transform: scale(1.05);
            box-shadow: 0 4px 16px rgba(29,78,216,0.4);
        }

    /* ── Responsive ── */
    @@media (max-width: 768px) {
        .quick-banner {
            padding: 2rem 1.5rem;
        }

            .quick-banner h2 {
                font-size: 1.5rem;
            }

        .section-title {
            font-size: 1.4rem;
        }
    }
</style>

<!-- Banner -->
<div class="quick-banner">
    <h2><i class="fas fa-tags"></i> Discover Amazing Products</h2>
    <p>Premium quality at unbeatable prices. Shop the latest trends today!</p>
</div>

<!-- Products -->
<div id="products">
    <div class="section-header">
        <h2 class="section-title">Featured Products</h2>
        <p class="section-subtitle">Discover our hand-picked selection of premium items</p>
    </div>

    <div class="row g-4" id="productsContainer">
        @foreach (var product in Model.Products)
        {
            <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                <div class="product-card">
                    <div class="product-image-wrapper">
                        <img src="@product.ImageUrl" alt="@product.Name" />
                        <span class="product-badge">New</span>
                    </div>
                    <div class="product-body">
                        <h3 class="product-title">@product.Name</h3>
                        <p class="product-description">Premium quality product with amazing features and benefits for everyday use</p>
                        <div class="product-footer">
                            <span class="product-price">$@product.Price</span>
                            <button class="btn-add-cart">
                                <i class="fas fa-cart-plus"></i> Add
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<script>
    document.getElementById('headerSearchInput').addEventListener('input', function(e) {
        const term = e.target.value.toLowerCase();
        document.querySelectorAll('.product-card').forEach(card => {
            const title = card.querySelector('.product-title').textContent.toLowerCase();
            const desc  = card.querySelector('.product-description').textContent.toLowerCase();
            card.closest('.col-12').style.display =
                (title.includes(term) || desc.includes(term)) ? '' : 'none';
        });
    });
</script>
